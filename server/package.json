{
  "name": "jlptquiz-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:migrate": "node migrate.js",
    "db:seed": "node seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "audio:generate": "node generate-audio.js",
    "lint": "eslint .",
    "test": "node --test"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "eslint": "^9.25.1",
    "supertest": "^7.3.1"
  }
}
