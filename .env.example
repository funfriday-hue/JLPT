PORT=3000
NODE_ENV=production
TRUST_PROXY=true
AUTO_MIGRATE=true
PUBLIC_BASE_URL=https://jlptquiz.in

# External PostgreSQL connection supplied by your managed database provider.
DATABASE_URL=postgresql://username:password@database-host:5432/jlptquiz
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

FIREBASE_PROJECT_ID=japanesenx-aman
# Base64-encoded Firebase service-account JSON. Keep this secret and never commit it.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Only needed when the UI is hosted on a different origin from the API.
CORS_ORIGIN=

# Never enable this in production. It exists only for local UI/API testing.
DEV_AUTH_BYPASS=false
