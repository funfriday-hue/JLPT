PORT=3000
NODE_ENV=production
TRUST_PROXY=true
AUTO_MIGRATE=true
PUBLIC_BASE_URL=https://jlptquiz.in

POSTGRES_DB=jlptquiz
POSTGRES_USER=jlptquiz
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://jlptquiz:replace-with-a-long-random-password@db:5432/jlptquiz
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

FIREBASE_PROJECT_ID=japanesenx-aman
# Base64-encoded Firebase service-account JSON. Keep this secret and never commit it.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Only needed when the UI is hosted on a different origin from the API.
CORS_ORIGIN=

# Never enable this in production. It exists only for local UI/API testing.
DEV_AUTH_BYPASS=false
