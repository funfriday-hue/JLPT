APP_PORT=3200
NODE_ENV=production
TRUST_PROXY=true
AUTO_MIGRATE=true
PUBLIC_BASE_URL=https://jlptquiz.in

# MySQL 8.0+ running on the same Linux server. Docker uses host networking.
DATABASE_URL=mysql://jlptquiz_app:replace-with-a-long-random-password@127.0.0.1:3306/jlptquiz
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

FIREBASE_PROJECT_ID=japanesenx-aman
# Base64-encoded Firebase service-account JSON. Keep this secret and never commit it.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Used only by the one-off Chirp audio generator container.
GOOGLE_TTS_CREDENTIALS_PATH=/root/secrets/jlptquiz-tts.json
CHIRP_VOICE=ja-JP-Chirp3-HD-Aoede
CHIRP_SPEAKING_RATE=0.95
CHIRP_FORCE=false

# Only needed when the UI is hosted on a different origin from the API.
CORS_ORIGIN=

# Never enable this in production. It exists only for local UI/API testing.
DEV_AUTH_BYPASS=false
